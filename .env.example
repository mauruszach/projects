# Only needed for local scripts that call Claude directly (e.g. resolve_entities.py).
# The API itself is bring-your-own-key: callers supply their own key via the
# X-Anthropic-Api-Key header, not this variable. See README's Deployment section.
ANTHROPIC_API_KEY=
NEO4J_URI=bolt://localhost:7688
NEO4J_USER=neo4j
NEO4J_PASSWORD=devpassword
GDELT_DATA_DIR=./data/gdelt
