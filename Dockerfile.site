FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /site
COPY projects/polymarket/requirements-hosting.txt /tmp/requirements.txt
RUN python3 -m venv /opt/polymarket-python && /opt/polymarket-python/bin/pip install --no-cache-dir -r /tmp/requirements.txt
COPY web/package.json web/package-lock.json ./web/
COPY projects/polymarket/web/package.json projects/polymarket/web/package-lock.json ./projects/polymarket/web/
RUN cd web && npm ci
RUN cd projects/polymarket/web && npm ci
COPY web ./web
COPY projects/polymarket ./projects/polymarket
COPY scripts/serve-site.mjs ./scripts/serve-site.mjs
RUN cd web && npm run build
RUN cd projects/polymarket/web && npm run build -- --webpack
RUN chown -R node:node /site
ENV NODE_ENV=production PORT=3000 POLYMARKET_PYTHON=/opt/polymarket-python/bin/python NEXT_TELEMETRY_DISABLED=1
USER node
EXPOSE 3000
CMD ["node", "scripts/serve-site.mjs"]
